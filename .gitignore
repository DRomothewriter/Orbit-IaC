# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data,
# but keep the example file.
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Ignore override files as they are usually used only locally.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI config files
.terraformrc
terraform.rc

# OS files
.DS_Store
Thumbs.db
