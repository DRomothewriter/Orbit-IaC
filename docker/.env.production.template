# ==============================================================================
# ORBIT BACKEND - VARIABLES DE ENTORNO EN PRODUCCIÓN (.env.production)
# ==============================================================================
# Copia este archivo a '.env.production' en /opt/orbit/ dentro de la instancia EC2.
# NUNCA subas '.env.production' a control de versiones.

# Servidor y Entorno
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://orbit.diego-romo-dev.com

# Base de Datos (MongoDB Atlas o clúster de base de datos)
# Asegurar que apunte a la base de datos /orbit
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/orbit?retryWrites=true&w=majority

# Autenticación y Seguridad
JWT_SECRET=super_secret_jwt_key_production_change_me
JWT_EXPIRES_IN=7d

# WebRTC / Mediasoup Configuration
# MEDIASOUP_ANNOUNCED_IP DEBE ser exactamente la Elastic IP asignada a la EC2
MEDIASOUP_ANNOUNCED_IP=18.xxx.xxx.xxx
MEDIASOUP_MIN_PORT=10000
MEDIASOUP_MAX_PORT=10100

# AWS S3 Storage para Avatares y Chat Media (multer-s3)
# La instancia EC2 utiliza el rol IAM asignado; no requiere AWS_ACCESS_KEY_ID
AWS_REGION=us-east-2
S3_MEDIA_BUCKET_NAME=orbit-media-storage-dev

# Registry de Docker (ECR)
ECR_REGISTRY=123456789012.dkr.ecr.us-east-2.amazonaws.com
IMAGE_TAG=latest
