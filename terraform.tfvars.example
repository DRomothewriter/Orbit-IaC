# ==============================================================================
# ORBIT INFRASTRUCTURE AS CODE - CONFIGURACIÓN DE VARIABLES DE EJEMPLO
# ==============================================================================
# Copia este archivo a 'terraform.tfvars' y completa con tus valores correspondientes.
# NUNCA subas 'terraform.tfvars' a control de versiones (ya está protegido en .gitignore).

aws_region   = "us-east-2"
environment  = "dev"
project_name = "orbit"
domain_name  = "orbitapp.dev"

tags = {
  Project     = "Orbit"
  Environment = "dev"
  ManagedBy   = "Terraform"
  Repository  = "https://github.com/DRomothewriter/Orbit-IaC"
}

# Configuración de cómputo EC2 para Backend y Mediasoup
instance_type    = "t3.small" # Usar t3.medium para entornos con mayor carga concurrente de WebRTC
root_volume_size = 30         # GiB

# Acceso SSH de administración (dejar vacío si se accede mediante AWS SSM Session Manager)
# admin_ssh_cidr   = ["203.0.113.10/32"]
admin_ssh_cidr   = []

# Orígenes CORS permitidos para el bucket S3 multimedia
cors_allowed_origins = [
  "http://localhost:4200",
  "https://orbitapp.dev",
  "https://*.orbitapp.dev",
  "https://orbit.diego-romo-dev.com"
]


